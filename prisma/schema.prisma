// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sale {
  id              Int      @id @default(autoincrement())
  productId       Int
  productName     String
  category        String
  priceUsd        Float
  quantitySold    Int
  totalSalesUsd   Float
  orderDate       DateTime
  customerCity    String
}
